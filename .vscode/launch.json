{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug fronthaul_sniffer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/fronthaul_sniffer",
            "args": ["--demo-pcap"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
