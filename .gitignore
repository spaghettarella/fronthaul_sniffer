build/
*.swp
*.swo

# Packet captures. Recordings are large and belong outside the repository -
# GitHub rejects anything over 100 MB outright. The four small pcaps under
# src/capture/ were committed before this rule and stay tracked, since
# ignoring a path has no effect on files git already follows.
*.pcap
*.pcapng

# Generated release bundles and their tarballs - see release/README.md.
# The script and its README stay tracked; the packaged output does not.
release/*/
release/*.tar.gz
